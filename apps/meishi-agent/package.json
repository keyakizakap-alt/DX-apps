{
  "name": "meishi-agent",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@noble/hashes": "^2.4.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tesseract.js-data/jpn": "^1.0.0",
    "@vercel/functions": "3.10.2",
