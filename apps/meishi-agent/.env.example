# Sync server (server/main.mts). Copy to .env or set in your hosting provider's secret settings.
# Never commit real values.

# Required in production: random string, 32+ characters (HMAC pepper for e-mail/OTP hashes).
MEISHI_SERVER_SECRET=
# Listening address / port (self-hosted Node only).
HOST=127.0.0.1
PORT=8787
# Storage: PostgreSQL when DATABASE_URL is set (Neon: use the pooled connection string with
# sslmode=require; on Vercel the Neon integration sets it). Otherwise a local SQLite file.
DATABASE_URL=
MEISHI_DB_PATH=.data/meishi-sync.sqlite
# Exact HTTPS origin(s) of the web app, comma-separated (CSRF Origin check).
MEISHI_ALLOWED_ORIGINS=https://meishi.example.invalid
# Set to 1 behind HTTPS so session cookies get the Secure flag (automatic when NODE_ENV=production).
MEISHI_SECURE_COOKIES=
NODE_ENV=development
# Behind a reverse proxy that OVERWRITES this header with the client IP (e.g. x-real-ip).
# Leave empty when clients connect directly (a client-set header would be trusted otherwise).
MEISHI_CLIENT_IP_HEADER=

# Sign-in code e-mail (required in production). Resend: create an API key and verify your sending
# domain at resend.com/domains; the testing sender onboarding@resend.dev only reaches your own address.
RESEND_API_KEY=
MEISHI_MAIL_FROM=名刺管理 <no-reply@mail.your-domain.example>

# Optional external AI (off by default; every send still needs per-request approval in the app).
# Default provider: Groq free plan (openai/gpt-oss-20b, no charge). Enable Zero Data Retention in
# the Groq console (Data Controls) and review its Services Agreement, then set both flags to 1.
MEISHI_AI_PROVIDER=groq
GROQ_API_KEY=
MEISHI_GROQ_ZDR_CONFIRMED=
MEISHI_AI_TERMS_CONFIRMED=
# Paid alternative (cheapest Claude, claude-haiku-5-5): set MEISHI_AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Native app (Expo): sync server URL baked into the development build.
EXPO_PUBLIC_SYNC_URL=
