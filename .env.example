# Runtime configuration only. Never put real secrets into source control.
ALLOWED_USER_EMAILS=owner@example.invalid
SITE_ORIGIN=https://your-private-site.example
ALLOWED_MODELS=openai/gpt-4.1-mini,google/gemini-2.5-flash
# Vercel access secrets. Generate strong unique values; never use these blank examples.
# APP_ACCESS_PASSWORD: at least 20 characters. SESSION_SECRET: random, at least 32 characters.
APP_ACCESS_PASSWORD=
SESSION_SECRET=
# Set as a secret in the hosting dashboard. Optional when using a session-only key through the UI.
OPENROUTER_API_KEY=
