# Runtime configuration only. Never put real secrets into source control.
# Optional on Vercel: exact HTTPS origin for a custom domain.
# Vercel deployment URLs are accepted using its built-in environment variables.
SITE_ORIGIN=
ALLOWED_MODELS=openai/gpt-4.1-mini,google/gemini-2.5-flash
# Configure only in hosting Environment Variables / Secrets, never in client code.
OPENROUTER_API_KEY=
# Sites-only private deployment setting. Ignored by the public Vercel adapter.
ALLOWED_USER_EMAILS=owner@example.invalid
# Vercel does not require APP_ACCESS_PASSWORD or SESSION_SECRET.
# Vercel: OPENROUTER_API_KEY must target Production; redeploy after changing it.
# Never use NEXT_PUBLIC_OPENROUTER_API_KEY. Users cannot supply keys in the app.
# The first permitted model is selected by the server configuration.
# Company workspace; omit allowlist to keep public demo without shared persistence.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
LOGIN_ALLOWED_EMAILS=
# Owner-managed mail service, verified sender and private scheduler credential.
RESEND_API_KEY=
NOTIFICATION_FROM=
CRON_SECRET=
# AI provider. Leave unset for OpenRouter. "groq" sends agent requests to Groq instead.
AI_PROVIDER=
# Groq (only when AI_PROVIDER=groq). Turn on Zero Data Retention in the Groq console's Data Controls first,
# then set GROQ_ZDR_CONFIRMED=true; without it, no material is sent.
GROQ_API_KEY=
GROQ_ZDR_CONFIRMED=
# Optional. Default model openai/gpt-oss-120b (supports strict structured output); output capped at 4000 tokens for the free tier.
GROQ_MODELS=
GROQ_MAX_OUTPUT_TOKENS=
# Optional, Groq only: Tavily key for the research step's public web search (sends the article topic only).
# Turn off "Allow Use of Query Data" in Tavily's account settings.
TAVILY_API_KEY=
